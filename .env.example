# Copy to .env and adjust. Everything here is free to run.

# Postgres + pgvector (docker-compose service "db")
DATABASE_URL=postgresql://rag:rag@localhost:5432/compliance

# Ollama runs natively on Windows (uses the GPU). Inside Docker the app reaches it via host.docker.internal.
OLLAMA_URL=http://localhost:11434
LLM_PROVIDER=ollama            # ollama | gemini
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
EMBED_MODEL=bge-m3
OLLAMA_NUM_CTX=8192

# Optional free cloud model: get a key at https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Retrieval
CHUNKING=article               # article | fixed
RERANKER=bge                   # bge | none
TOP_K=5
